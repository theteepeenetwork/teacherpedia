#--------------------------------------------------------------------
# Teacherpedia environment template
#--------------------------------------------------------------------
# Copy this file to ci4/.env and fill in real values for your
# environment. This template MUST NOT contain real secrets, and the
# resulting ci4/.env file MUST NEVER be committed to version control.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE - development
#--------------------------------------------------------------------
database.development.hostname = localhost
database.development.username = teacherpedia
database.development.password = teacherpedia
database.development.database = teacherpedia
database.development.DBDriver = MySQLi

#--------------------------------------------------------------------
# DATABASE - production (fill in on the deployment host; never commit)
#--------------------------------------------------------------------
# database.production.hostname =
# database.production.username =
# database.production.password =
# database.production.database =
# database.production.DBDriver = MySQLi

