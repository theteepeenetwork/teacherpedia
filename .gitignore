# OS / editor cruft
.DS_Store
*.swp
Thumbs.db

# Composer
/vendor/

# Environment
.env

# CodeIgniter writable runtime
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/debugbar/*
writable/uploads/*
!writable/uploads/index.html

# Local SQLite database files (keep the directory via .gitkeep)
writable/db/*.db
writable/db/*.sqlite
writable/db/*.sqlite3
!writable/db/.gitkeep

# Build/test artifacts
/phpunit.xml
.phpunit.*.cache
/coverage*

# Local resource backup (not part of the app)
/resources_backup/
